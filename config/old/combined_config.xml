<!-- config/combined_config.xml -->
<configuration>
    <!-- Existing Sections -->
    <logging>
        <setting name="log_dir_name" value="logs" type="string"/>
        <setting name="log_file_max_bytes" value="5000" type="integer"/>
        <setting name="log_gen_level" value="INFO" type="string"/>
    </logging>
    <constants>
        <setting name="max_retries" value="2" type="integer"/>
        <setting name="is_test_mode" value="true" type="boolean"/>
    </constants>
    <menu name="Main">
        <menu name="Trading">
            <help>Test trading menu</help>
            <item name="Start">
                <help>Start test trade</help>
                <param name="amount" default="50.0" type="float"/>
            </item>
        </menu>
        <menu name="Settings">
            <help>Test settings</help>
        </menu>
        <menu name="Exit">
            <help>Exit test</help>
        </menu>
    </menu>
    <!-- New Features -->
    <templates>
        <template id="default_process">
            <setting name="interval" value="60" type="integer"/>
            <setting name="enabled" value="true" type="boolean"/>
        </template>
    </templates>
    <processes>
        <!-- Hierarchical Attributes -->
        <process id="fetch" interval="60" type_interval="integer" enabled="true" type_enabled="boolean"/>
        <!-- Template-Based -->
        <process template="default_process">
            <setting name="priority" value="high" type="string"/>
        </process>
        <!-- Conditional Config -->
        <process>
            <condition env="test">
                <setting name="interval" value="30" type="integer"/>
                <setting name="mode" value="debug" type="string"/>
            </condition>
            <condition env="prod">
                <setting name="interval" value="300" type="integer"/>
                <setting name="mode" value="optimized" type="string"/>
            </condition>
        </process>
        <!-- Embedded SQL -->
        <process>
            <setting name="interval" value="120" type="integer"/>
            <sql name="fetch_messages"><![CDATA[
                SELECT * FROM telegram_messages WHERE timestamp > NOW() - INTERVAL '1 hour';
            ]]></sql>
        </process>
    </processes>
    <!-- External File Reference -->
    <include file="config/processes.xml"/>
</configuration>